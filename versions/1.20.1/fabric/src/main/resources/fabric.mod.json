{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "assets/mccs/icon.png",
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "environment": "*",
  "accessWidener": "mccs.accesswidener",
  "entrypoints": {
    "main": ["de.mccs.fabric.MccsFabric"],
    "client": ["de.mccs.fabric.client.MccsFabricClient"]
  },
  "mixins": ["mccs.mixins.json", "mccs.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "team_reborn_energy": "*"
  }
}
